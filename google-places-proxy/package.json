{
	"name": "google-places-proxy",
	"version": "0.0.0",
	"private": true,
	"packageManager": "npm@12.0.2",
	"engines": {
		"node": ">=24.21.0 <25",
		"npm": ">=12.0.2 <13"
	},
	"scripts": {
		"preinstall": "npm --prefix .. run check:dependencies",
		"pretest": "npm --prefix .. run check:dependencies",
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
		"build": "wrangler deploy --dry-run --outdir dist",
		"cf-typegen": "wrangler types"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.1.8",
		"@cloudflare/workers-types": "5.20260911.1",
		"typescript": "7.0.2",
		"vitest": "4.1.11",
		"wrangler": "4.131.1"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"workerd@1.20260911.1": true
	}
}
